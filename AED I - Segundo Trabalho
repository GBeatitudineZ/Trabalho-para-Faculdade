int main() {
    setlocale(LC_ALL, "pt_BR.UTF-8"); 
    ListaTelefonica lista;
    int opcao;
    char nome[MAX_NOME];
    char telefone[MAX_TELEFONE];
    char data[MAX_DATA];
    char email[MAX_EMAIL];
    
    inicializarLista(&lista);
    carregarDoArquivo(&lista);
    
    do {
        mostrarMenu();
        if (scanf("%d", &opcao) != 1) {
            printf("Entrada inválida!\n");
            limparBuffer();
            opcao = -1;
            continue;
        }
        limparBuffer();
        
        switch (opcao) {
            case 1: exibirLista(&lista); break;
            case 2:
                printf("\n--- INSERIR NOVO CONTATO ---\n");
                printf("Nome: "); fgets(nome, MAX_NOME, stdin); nome[strcspn(nome, "\n")] = '\0';
                printf("Telefone: "); fgets(telefone, MAX_TELEFONE, stdin); telefone[strcspn(telefone, "\n")] = '\0';
                printf("Data de Nascimento: "); fgets(data, MAX_DATA, stdin); data[strcspn(data, "\n")] = '\0';
                printf("Email: "); fgets(email, MAX_EMAIL, stdin); email[strcspn(email, "\n")] = '\0';
                inserirContato(&lista, nome, telefone, data, email);
                exibirLista(&lista);
                break;
            case 3:
                printf("\nDigite o nome para buscar: ");
                fgets(nome, MAX_NOME, stdin); nome[strcspn(nome, "\n")] = '\0';
                buscarPorNome(&lista, nome);
                break;
            case 4:
                printf("\nDigite o nome do contato a remover: ");
                fgets(nome, MAX_NOME, stdin); nome[strcspn(nome, "\n")] = '\0';
                removerContato(&lista, nome);
                exibirLista(&lista);
                break;
            case 5: navegarProximo(&lista); break;
            case 6: navegarAnterior(&lista); break;
            case 7: exibirContatoAtual(&lista); break;
            case 8: ordenarPorNome(&lista); break;
            case 9: salvarEmArquivo(&lista); break;
            case 10:
                liberarLista(&lista);
                carregarDoArquivo(&lista);
                break;
            case 0:
                printf("\nEncerrando o programa...\nSalvando dados...\n");
                salvarEmArquivo(&lista);
                liberarLista(&lista);
                printf("Programa encerrado com sucesso!\n");
                break;
            default: printf("Opção inválida! Tente novamente.\n");
        }
    } while (opcao != 0);
    
    return 0;
}
